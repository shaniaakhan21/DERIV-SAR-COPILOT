# ============================================
# SAR Copilot Frontend - Environment Configuration
# ============================================

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# Backend API URL (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001

# --------------------------------------------
# Optional: Feature Flags
# --------------------------------------------
# Enable/disable real-time simulation feature
# VITE_ENABLE_SIMULATION=true

# Enable/disable unsupervised discovery tab
# VITE_ENABLE_UNSUPERVISED=true

# Enable/disable metrics dashboard
# VITE_ENABLE_METRICS=true

# --------------------------------------------
# Optional: UI Configuration
# --------------------------------------------
# Default simulation duration (seconds)
# VITE_SIMULATION_DURATION=45

# Default max cases to display
# VITE_DEFAULT_MAX_CASES=50

# Default min risk score filter
# VITE_DEFAULT_MIN_SCORE=0

# ============================================
# Setup Instructions:
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env if you need custom backend URL
# 3. Restart dev server after changes: npm run dev
# 4. Never commit .env to git (it's in .gitignore)
# ============================================

# Note: Vite requires VITE_ prefix for env variables
# to be exposed to the client-side code
