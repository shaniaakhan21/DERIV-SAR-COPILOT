# ============================================
# SAR Copilot - Environment Configuration
# ============================================

# --------------------------------------------
# OpenRouter API Configuration (REQUIRED for SAR generation)
# --------------------------------------------
# Get your FREE API key from: https://openrouter.ai/keys
# OpenRouter gives you access to 100+ LLMs through one API!
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use for SAR generation
# FREE Options (no credit card required):
#   - meta-llama/llama-3.1-8b-instruct:free (recommended - fast & free)
#   - google/gemini-flash-1.5 (fast, excellent quality, free)
#   - mistralai/mistral-7b-instruct:free (good quality, free)
#   - qwen/qwen-2-7b-instruct:free (fast, free)
# 
# Paid Options (better quality, requires credits):
#   - anthropic/claude-3.5-sonnet (best quality)
#   - openai/gpt-4o (excellent)
#   - google/gemini-pro-1.5 (great quality)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --------------------------------------------
# SAR Generation Settings
# --------------------------------------------
# Cases with score below this threshold get "review note" instead of full SAR
# Range: 0-100 (recommended: 30-40)
SAR_THRESHOLD=35

# --------------------------------------------
# Unsupervised Learning Parameters
# --------------------------------------------
# DBSCAN epsilon - cluster radius (higher = larger clusters)
# Range: 0.5-2.0 (recommended: 1.0-1.5)
UC_EPS=1.2

# DBSCAN min points - minimum cluster density
# Range: 2-5 (recommended: 3)
UC_MINPTS=3

# Rare cluster threshold - clusters smaller than this are "rare"
# Range: 1-5 (recommended: 2-3)
UC_RAREK=2

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Backend server port
PORT=3001

# --------------------------------------------
# Optional: Advanced Settings
# --------------------------------------------
# Uncomment to enable debug logging
# DEBUG=true

# Uncomment to set custom CORS origin
# CORS_ORIGIN=http://localhost:5173

# Uncomment to set request timeout (milliseconds)
# REQUEST_TIMEOUT=30000

# ============================================
# Setup Instructions:
# ============================================
# 1. Go to: https://openrouter.ai/keys
# 2. Sign up (FREE - no credit card for free models!)
# 3. Create API key
# 4. Copy this file: cp .env.example .env
# 5. Edit .env and paste your API key
# 6. Save and start: npm run dev
# ============================================

# ============================================
# Why OpenRouter?
# ============================================
# ✅ Access to 100+ LLMs through one API
# ✅ FREE models available (no credit card)
# ✅ Easy to switch between models
# ✅ Competitive pricing for paid models
# ✅ Simple OpenAI-compatible API
# ============================================
