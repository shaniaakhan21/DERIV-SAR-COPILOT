# ============================================
# SAR Copilot - Environment Configuration
# ============================================

# --------------------------------------------
# OpenAI API Configuration (REQUIRED for SAR generation)
# --------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for SAR generation
# Options:
#   - gpt-4o-mini (recommended - fast & affordable)
#   - gpt-4o (best quality)
#   - gpt-4-turbo (excellent quality)
#   - gpt-3.5-turbo (fastest, cheapest)
OPENAI_MODEL=gpt-4o-mini

# --------------------------------------------
# SAR Generation Settings
# --------------------------------------------
# Cases with score below this threshold get "review note" instead of full SAR
# Range: 0-100 (recommended: 30-40)
SAR_THRESHOLD=35

# --------------------------------------------
# Unsupervised Learning Parameters
# --------------------------------------------
# DBSCAN epsilon - cluster radius (higher = larger clusters)
# Range: 0.5-2.0 (recommended: 1.0-1.5)
UC_EPS=1.2

# DBSCAN min points - minimum cluster density
# Range: 2-5 (recommended: 3)
UC_MINPTS=3

# Rare cluster threshold - clusters smaller than this are "rare"
# Range: 1-5 (recommended: 2-3)
UC_RAREK=2

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Backend server port
PORT=3001

# --------------------------------------------
# Optional: Advanced Settings
# --------------------------------------------
# Uncomment to enable debug logging
# DEBUG=true

# Uncomment to set custom CORS origin
# CORS_ORIGIN=http://localhost:5173

# Uncomment to set request timeout (milliseconds)
# REQUEST_TIMEOUT=30000

# ============================================
# Setup Instructions:
# ============================================
# 1. Go to: https://platform.openai.com/api-keys
# 2. Sign in or create account
# 3. Create API key
# 4. Copy this file: cp .env.example .env
# 5. Edit .env and paste your API key
# 6. Save and start: npm run dev
# ============================================
